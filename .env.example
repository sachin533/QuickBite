# QuickBite local development configuration.
# Copy to `.env` (never commit `.env`) and adjust as needed.

# --- service -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (SQLAlchemy dialect URL) ---------------------------------
DATABASE_URL=postgresql+psycopg://quickbite:quickbite@localhost:5432/quickbite

# --- RabbitMQ ------------------------------------------------------------
# Local docker: amqp://guest:guest@localhost:5672/%2F
# Compose network (workers/api): amqp://guest:guest@rabbitmq:5672/%2F
AMQP_URL=amqp://guest:guest@localhost:5672/%2F
AMQP_CONNECT_TIMEOUT_S=10
WORKER_PREFETCH=8

# Bounded retry policy: 1 initial attempt + 3 delayed retries.
RETRY_MAX_ATTEMPTS=3
RETRY_DELAYS_SECONDS=2,10,30

# --- authentication ------------------------------------------------------
# REQUIRED: at least 32 characters of randomness. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# --- CORS (explicit origins, comma separated, never "*" with credentials) -
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- deterministic simulation controls (development/test only) ----------
# payment: success | fail_twice | fail_always
PAYMENT_MODE=success
RESTAURANT_MODE=success
DELIVERY_MODE=success
NOTIFICATION_MODE=success
PAYMENT_DELAY_MS=150
RESTAURANT_DELAY_MS=100
DELIVERY_DELAY_MS=100
NOTIFICATION_DELAY_MS=50
